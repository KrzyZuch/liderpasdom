---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="Artykuły o budownictwie pasywnym, izolacji PiR i energooszczędności">
  <section class="blog-header">
    <h1>Blog o Budownictwie Pasywnym</h1>
    <p>Praktyczna wiedza, analizy kosztów i nowoczesne rozwiązania</p>
  </section>

  <section class="posts-list">
    {posts.map((post) => (
      <article class="post-item">
        <a href={`/blog/${post.slug}`}>
          <h2>{post.data.title}</h2>
          <p class="description">{post.data.description}</p>
          <div class="meta">
            <time>{post.data.date.toLocaleDateString('pl-PL')}</time>
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .blog-header {
    text-align: center;
    padding: 3rem 1rem;
    background: var(--color-muted);
    border-radius: 1rem;
    margin-bottom: 2rem;
  }
  
  .blog-header h1 {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  
  .blog-header p {
    color: #6b7280;
  }
  
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .post-item {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    transition: box-shadow 0.2s;
  }
  
  .post-item:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  }
  
  .post-item a {
    display: block;
    padding: 1.5rem;
    color: inherit;
    text-decoration: none;
  }
  
  .post-item h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  
  .post-item .description {
    color: #6b7280;
    margin-bottom: 1rem;
  }
  
  .post-item .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  
  .post-item time {
    font-size: 0.875rem;
    color: #9ca3af;
  }
  
  .tags {
    display: flex;
    gap: 0.5rem;
  }
  
  .tag {
    background: var(--color-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-primary);
  }
</style>
